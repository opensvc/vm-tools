  },
  "software": {
    "patterns": [
      "base",
      "minimal_base"
    ],
    "packages": [
      "openssh",
      "sudo",
      "xfsprogs",
      "lvm2",
      "mdadm",
      "vim",
      "sg3_utils",
      "numactl",
      "kdump",
      "irqbalance",
      "e2fsprogs",
      "btrfsprogs",
      "snapper",
      "chrony",
      "wget",
      "curl",
      "tar",
      "gzip",
      "suseconnect-ng"
    ]
  },
  "storage": {
    "drives": [
      {
        "partitions": [
          {
            "search": "*",
            "delete": true
          },
          {
            "filesystem": {
              "path": "/",
              "type": {
                "btrfs": {
                  "snapshots": true
                }
              }
            },
            "size": "15 GiB"
          },
          {
            "filesystem": {
              "path": "/home",
              "type": "xfs"
            },
            "size": "7 GiB"
          },
          {
            "filesystem": {
              "path": "swap",
              "type": "swap"
            },
            "size": "8 GiB"
          }
        ]
      }
    ]
  },
  "scripts": {
    "post": [
      {
        "name": "add_packer_sudo_rule.sh",
        "chroot": true,
        "content": "#!/bin/sh\nprintf 'Defaults:packer !targetpw\\npacker ALL=(ALL,ALL) NOPASSWD: ALL\\n' > /etc/sudoers.d/packer\nchmod 440 /etc/sudoers.d/packer\n"
      },
      {
        "name": "services.sh",
        "chroot": true,
        "content": "#!/bin/sh\nsystemctl enable sshd.service\nsystemctl disable firewalld.service || true\n# no LSM, like the previous sles16 image (installed with security=)\nif [ -f /etc/selinux/config ]; then\n    sed -i 's/^SELINUX=.*/SELINUX=disabled/' /etc/selinux/config\nfi\n"
      }
    ]
  }
}
